PORT=3001
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=admin@insonetgh.com
ADMIN_PASSWORD=admin123

# Contact form email notifications
# Messages from the website contact form are emailed to CONTACT_NOTIFY_EMAIL.
#
# Gmail / Google Workspace example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="INSONET Website" <your-account@gmail.com>
#
# cPanel / hosting provider example:
#   SMTP_HOST=mail.insonetgh.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=info@insonetgh.com
#   SMTP_PASS=your-mailbox-password
#   SMTP_FROM="INSONET Website" <info@insonetgh.com>

CONTACT_NOTIFY_EMAIL=info@insonetgh.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="INSONET Website" <info@insonetgh.com>
